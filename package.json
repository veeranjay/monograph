{
  "name": "monograph",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/server.ts",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:client",
    "start": "tsx src/server/server.ts",
    "seed": "tsx src/server/seed.ts",
    "typecheck": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "test": "tsx --test tests/workspace.test.ts",
    "test:browser": "playwright test",
    "test:legacy": "tsx --test tests/practice_logs_and_guardrails.test.ts tests/challenger_m1.test.ts tests/adversarial_challenger2.test.ts tests/e2e/tier2_database.test.ts tests/e2e/tier3_api.test.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "test:formatting": "tsx --test tests/notes_formatting.test.ts",
    "format": "prettier --write src/client/workspace src/client/lib/latex.ts src/client/lib/mathCommands.ts src/client/styles/*.css scripts tests/browser"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.106.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
